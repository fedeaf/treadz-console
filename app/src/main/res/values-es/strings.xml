    <!-- Permissions -->
    <string name="perm_title">Se necesita permiso de Bluetooth</string>
    <string name="perm_body">TreadZ Console necesita buscar dispositivos cercanos y conectarse a ellos para hablar con tu cinta. Solo se usa para eso.</string>
    <string name="perm_grant">Conceder permiso</string>
    <string name="perm_denied_title">Permiso de Bluetooth denegado</string>
    <string name="perm_denied_body">Sin este permiso la app no puede buscar ni conectarse a la cinta. Puedes intentarlo de nuevo o permitirlo en los ajustes del sistema.</string>
    <string name="perm_denied_permanent_body">Sin este permiso la app no puede buscar ni conectarse a la cinta. Android no volverá a preguntar: permite «Dispositivos cercanos» en los ajustes de la app.</string>
    <string name="perm_open_settings">Abrir ajustes de la app</string>
    <string name="notifications_denied">Las notificaciones están desactivadas: no se verá el aviso de que la app sigue funcionando en segundo plano.</string>

