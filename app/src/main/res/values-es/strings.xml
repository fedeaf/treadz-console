    <!-- Alerts -->
    <string name="alert_dismiss">Entendido</string>
    <string name="alert_key_title">LLAVE DE SEGURIDAD QUITADA</string>
    <string name="alert_key_body">La banda se ha parado, pero la plataforma SIGUE INCLINADA. Bajará a 0 % en cuanto vuelvas a poner la llave: sujétate bien o apártate antes de ponerla. La sesión de la cinta se perderá.</string>
    <string name="alert_connection_lost_title">CONEXIÓN PERDIDA</string>
    <string name="alert_connection_lost_body">Se ha perdido la conexión Bluetooth con la cinta. La cinta se para sola y su sesión se pierde. Si la banda sigue en marcha, pulsa STOP en la consola o quita la llave.</string>
    <string name="alert_data_stalled_title">SIN DATOS DE LA CINTA</string>
    <string name="alert_data_stalled_body">La cinta ha dejado de enviar datos, así que los valores en pantalla pueden estar desfasados. Ante la duda, pulsa STOP en la consola o quita la llave.</string>
    <string name="alert_command_title">ORDEN NO EJECUTADA</string>
    <string name="alert_command_body">La cinta aceptó la orden \"%1$s\" pero no la ha ejecutado. Pulsa STOP en la consola o quita la llave.</string>

