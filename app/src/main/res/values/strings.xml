    <!-- Alerts -->
    <string name="alert_dismiss">Understood</string>
    <string name="alert_key_title">SAFETY KEY REMOVED</string>
    <string name="alert_key_body">The belt has stopped, but the platform is STILL INCLINED. It will drop to 0% as soon as you put the key back, so hold on or step aside before doing it. The session on the treadmill will be lost.</string>
    <string name="alert_connection_lost_title">CONNECTION LOST</string>
    <string name="alert_connection_lost_body">The Bluetooth connection with the treadmill was lost. The treadmill stops by itself and its session is lost. If the belt keeps moving, press STOP on the console or remove the key.</string>
    <string name="alert_data_stalled_title">NO DATA FROM THE TREADMILL</string>
    <string name="alert_data_stalled_body">The treadmill has stopped sending data, so the values on screen may be out of date. If in doubt, press STOP on the console or remove the key.</string>
    <string name="alert_command_title">COMMAND NOT EXECUTED</string>
    <string name="alert_command_body">The treadmill accepted the command \"%1$s\" but did not carry it out. Press STOP on the console or remove the key.</string>

