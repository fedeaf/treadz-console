    <!-- Permissions -->
    <string name="perm_title">Bluetooth permission needed</string>
    <string name="perm_body">TreadZ Console needs to find nearby devices and connect to them to talk to your treadmill. It is only used for that.</string>
    <string name="perm_grant">Grant permission</string>
    <string name="perm_denied_title">Bluetooth permission denied</string>
    <string name="perm_denied_body">Without this permission the app cannot find or connect to the treadmill. You can try again, or allow it in the system settings.</string>
    <string name="perm_denied_permanent_body">Without this permission the app cannot find or connect to the treadmill. Android will not ask again: allow \"Nearby devices\" in the app settings.</string>
    <string name="perm_open_settings">Open app settings</string>
    <string name="notifications_denied">Notifications are off: the notice that shows the app keeps running in the background will not appear.</string>

